# Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tonris_db
DB_USER=root
DB_PASSWORD=

# Logging Configuration
LOG_LEVEL=info

# Multi-tenant Configuration
DEFAULT_TENANT_ID=default

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Legacy price IDs (backward compatibility)
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_YEARLY_PRICE_ID=price_your_yearly_price_id
# Tiered pricing - Starter
STRIPE_STARTER_MONTH_PRICE_ID=
STRIPE_STARTER_YEAR_PRICE_ID=
# Tiered pricing - Professional
STRIPE_PROFESSIONAL_MONTH_PRICE_ID=
STRIPE_PROFESSIONAL_YEAR_PRICE_ID=
# Tiered pricing - Business
STRIPE_BUSINESS_MONTH_PRICE_ID=
STRIPE_BUSINESS_YEAR_PRICE_ID=
# Metered overage pricing (tier-specific)
STRIPE_STARTER_OVERAGE_PRICE_ID=
STRIPE_PROFESSIONAL_OVERAGE_PRICE_ID=
STRIPE_BUSINESS_OVERAGE_PRICE_ID=
STRIPE_METER_ID=

# Twilio Configuration (Voice/Telephony)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
APP_BASE_URL=http://localhost:3000

# Twilio SMS Configuration
TWILIO_SMS_ACCOUNT_SID=
TWILIO_SMS_AUTH_TOKEN=
TWILIO_SMS_PHONE_NUMBER=

# ElevenLabs Configuration
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_WEBHOOK_SECRET=

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Admin Configuration
ADMIN_PASSWORD=

# Resend Email Configuration
RESEND_API_KEY=

# Cron Job Configuration
CRON_SECRET=

# Frontend Configuration
# Used to generate password reset links in emails that redirect users to the frontend
FRONTEND_URL=http://localhost:5173

# Health Monitor Configuration (Self-healing DB monitoring)
# Comma-delimited phone numbers to receive SMS alerts on DB failure
HEALTH_ALERT_PHONES=
# How often to check DB (cron expression, default: every 2 minutes)
HEALTH_CHECK_INTERVAL=*/2 * * * *
# How many consecutive failures before alerting/restarting (default: 3)
HEALTH_FAILURE_THRESHOLD=3
# Whether to exit process on failure, letting Railway restart (default: true)
HEALTH_EXIT_ON_FAILURE=true
